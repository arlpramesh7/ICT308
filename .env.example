# Copy to backend/.env only for manual configuration; npm run setup generates it.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
APP_ORIGIN=http://localhost:4000
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
# Optional Web Push keys. Generate unique keys with setup; never commit them.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://github.com/arlpramesh7/ICT308
DEMO_DATA=true
